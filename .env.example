# Porta interna do servidor (o Coolify faz o proxy para o domínio)
PORT=3000
# Pasta persistente com o banco SQLite (poker.sqlite) e o logo
DATA_DIR=/data
# PIN exigido para alterar dados (criar torneio, dar play, registrar eliminação...).
# Vazio = qualquer pessoa com o link altera. A TV só lê, não precisa de PIN.
ADMIN_PIN=
